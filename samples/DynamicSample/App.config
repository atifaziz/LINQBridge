<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The sample is compiled for CLR 2.0. Listing v4.0 first lets it also run on a machine that
       only has .NET 4.x installed, which is how it is exercised in CI. -->
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
    <supportedRuntime version="v2.0.50727" />
  </startup>
</configuration>
